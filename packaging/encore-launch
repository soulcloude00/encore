#!/bin/sh
# Relaunch crashes at most three times a minute; preserve command-line arguments.
# Resolve from this script so release archives and custom install prefixes work.
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin="$launcher_dir/../lib/encore/encore"
count=0
window_start=$(date +%s)
while :; do
  "$bin" "$@"
  rc=$?
  case $rc in
    101 | 133 | 134 | 135 | 139) ;;
    *) exit "$rc" ;;
  esac
  now=$(date +%s)
  if [ $((now - window_start)) -gt 60 ]; then
    count=0
    window_start=$now
  fi
  count=$((count + 1))
  [ "$count" -gt 3 ] && exit "$rc"
  sleep 2
done
